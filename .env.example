# 多平台内容发布 Agent - 环境变量配置
# 复制为 .env 后填入你的 Key：cp .env.example .env

# 必须：硅基流动 API Key（文案生成 + 配图生成）
SILICONFLOW_API_KEY=sk-xxx…xxxx

# 可选：微信公众平台（已对接）
# 到 mp.weixin.qq.com → 设置与开发 → 基本配置 获取
WEIXIN_APP_ID=
WEIXIN_APP_SECRET=

# 可选：抖音（开发中）
DOUYIN_ACCESS_TOKEN=

# 可选：输出目录
OUTPUT_DIR=./output

# 可选：默认配图模型
DEFAULT_IMAGE_MODEL=Qwen/Qwen-Image
