# ============================================================
# 多平台内容发布 Agent - 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入你的 Key
# cp .env.example .env

# 必须：硅基流动 API Key（文案生成 + 配图生成）
# 注册：https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：各平台发布 API（开发中，留空则仅生成草稿）
# 小红书 - 目前无开放发布 API，建议手动复制粘贴
# 微信公众平台 - 需要到微信公众平台获取
WEIXIN_APP_ID=
WEIXIN_APP_SECRET=
# 抖音 - 需要到抖音开放平台获取
DOUYIN_ACCESS_TOKEN=

# 可选：输出目录
OUTPUT_DIR=./output

# 可选：默认配图模型
DEFAULT_IMAGE_MODEL=Qwen/Qwen-Image
